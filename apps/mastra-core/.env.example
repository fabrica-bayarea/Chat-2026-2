# Servidor HTTP (POST /api/chat)
PORT=3000

# Origem permitida no CORS (URL do front). Para várias origens, separe por vírgula.
CORS_ORIGIN=http://localhost:5173

# Endereço da API do Ollama (padrão local)
OLLAMA_BASE_URL=http://localhost:11434/api

# Nome de um modelo baixado no Ollama (veja com `ollama list`). Ainda não definido.
LLM_MODEL=

# Parâmetros de geração
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_MS=30000


# Limites de validação do corpo da requisição
CHAT_MAX_BODY_BYTES=100000
CHAT_MAX_MESSAGES=50
CHAT_MAX_MESSAGE_CHARS=4000

# MCP via stdio. Sem MCP_COMMAND, conversa funciona sem ferramentas.
# Caminhos relativos ao diretório apps/mastra-core (scripts pnpm deste pacote).
MCP_COMMAND=node
MCP_ARGS=["--import","tsx","../mcp-server/src/server.ts"]
MCP_TIMEOUT_MS=5000
# Ambiente passado ao processo MCP; não versionar valores reais ou credenciais.
MCP_ENV={"API_MOCK_URL":"http://127.0.0.1:4000","API_MOCK_TIMEOUT_MS":"3000"}
# Opcional: diretório de trabalho do processo MCP.
# MCP_CWD=/caminho/absoluto/apps/mastra-core
