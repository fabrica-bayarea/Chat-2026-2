# Servidor HTTP (POST /api/chat)
PORT=3000

# Origem permitida no CORS (URL do front). Para várias origens, separe por vírgula.
CORS_ORIGIN=http://localhost:5173

# Endereço da API do Ollama (padrão local)
OLLAMA_BASE_URL=http://localhost:11434/api

# Nome de um modelo baixado no Ollama (veja com `ollama list`). Ainda não definido.
LLM_MODEL=

# Parâmetros de geração
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_MS=30000


# Limites de validação do corpo da requisição
CHAT_MAX_BODY_BYTES=100000
CHAT_MAX_MESSAGES=50
CHAT_MAX_MESSAGE_CHARS=4000

# Ingestão RAG (pnpm --filter mastra-core rag:ingest)
# Modelo de embeddings baixado no Ollama (ex.: `ollama pull nomic-embed-text`)
RAG_EMBEDDING_MODEL=nomic-embed-text

# Base vetorial local (LibSQL) e nome do índice
RAG_VECTOR_DB_URL=file:./data/rag.db
RAG_INDEX_NAME=base_institucional

# Pasta com os documentos públicos (PDF, DOC, DOCX) a serem ingeridos
RAG_DOCUMENTS_DIR=./data/documentos

# Tamanho dos chunks e sobreposição (em caracteres)
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150

# Tempo máximo para baixar cada página/arquivo
RAG_FETCH_TIMEOUT_MS=15000
