# Servidor HTTP (POST /api/chat)
PORT=3000

# Origem permitida no CORS (URL do front). Para várias origens, separe por vírgula.
CORS_ORIGIN=http://localhost:5173

# Endereço da API do Ollama (padrão local)
OLLAMA_BASE_URL=http://localhost:11434/api

# Nome de um modelo baixado no Ollama (veja com `ollama list`).
# Recomendado: qwen2.5:7b (mais fiel à base). O llama3.2:3b é mais rápido, mas inventa detalhes.
LLM_MODEL=

# Parâmetros de geração. Temperatura 0 deixa a resposta presa ao texto da base.
# Em CPU, um modelo de 7B leva até cerca de 1 minuto em perguntas grandes
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_MS=120000
# Janela do modelo no Ollama, em tokens (instruções + histórico + trechos da base + resposta
# precisam caber). Com 4096, perguntas grandes com trechos da base estouram e o Ollama corta o prompt
LLM_NUM_CTX=8192

# Janela de contexto da conversa: o que vai para o modelo a cada resposta
# (as últimas N mensagens, somando até CONTEXT_MAX_CHARS caracteres, ~4 caracteres por token)
CONTEXT_HISTORY_SIZE=10
CONTEXT_MAX_CHARS=6000


# Limites de validação do corpo da requisição
CHAT_MAX_BODY_BYTES=100000
CHAT_MAX_MESSAGES=50
CHAT_MAX_MESSAGE_CHARS=4000

# Ingestão RAG (pnpm --filter mastra-core rag:ingest)
# Modelo de embeddings baixado no Ollama (ex.: `ollama pull nomic-embed-text`)
RAG_EMBEDDING_MODEL=nomic-embed-text

# Base vetorial local (LibSQL) e nome do índice
RAG_VECTOR_DB_URL=file:./data/rag.db
RAG_INDEX_NAME=base_institucional

# Pasta com os documentos públicos (PDF, DOC, DOCX) a serem ingeridos
RAG_DOCUMENTS_DIR=./data/documentos

# Tamanho dos chunks e sobreposição (em caracteres)
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150

# Tempo máximo para baixar cada página/arquivo
RAG_FETCH_TIMEOUT_MS=15000

# Recuperação: tamanho máximo da pergunta enviada para a busca
RAG_QUERY_MAX_CHARS=1000

# Quantidade de trechos devolvidos pela busca
RAG_TOP_K=4

# Similaridade mínima (0 a 1) para um trecho ser considerado relevante
RAG_MIN_SCORE=0.69

# Página com até esse número de trechos entra inteira quando um deles é encontrado (0 desliga).
# Traz dados como endereço e telefone, que ficam em trechos pouco parecidos com a pergunta
RAG_EXPAND_SOURCE_CHUNKS=3
