# Porta do backend (a 3000 é do mastra-core)
PORT=3001

# Origem do front (pode ter várias, separadas por vírgula). Precisa ser exata: o login usa cookie.
CORS_ORIGIN=http://localhost:5173

# Segredo do JWT da sessão (mínimo 32 caracteres). Gere um valor seu, por exemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Nunca versionar o valor real.
AUTH_JWT_SECRET=

# Duração da sessão em horas
AUTH_SESSION_HOURS=8

# Cookie só por HTTPS. Em produção (NODE_ENV=production) é sempre true.
AUTH_COOKIE_SECURE=false
