# Porta do backend (a 3000 é usada pelo mastra-core, a API do chat)
PORT=3001

# Origem do front (pode ter várias, separadas por vírgula). Precisa ser exata: o histórico usa cookie.
CORS_ORIGIN=http://localhost:5173

# PostgreSQL do histórico de conversas. Para desenvolvimento, suba o banco do docker-compose:
#   docker compose up -d postgres
# O backend aplica as migrations da pasta migrations/ (raiz) sozinho ao subir.
DATABASE_URL=postgres://chat:chat_dev@localhost:5433/chat_historico
